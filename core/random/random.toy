'random package

'choice [
    dup sequence? not
    [ "'random.choice' expected a sequence" error ] if
    dup empty?
    [ "'random.choice' expected a non-empty sequence" error ] if
    dup list? [ >vector ] if
    dup len 0 swap int
    at
] def

'shuffle-step [ | index |
    0 $index 1 + int | other |
    dup $index at
    over $other at
    $index swap rot
    [ set-at ] dip
    $other swap set-at
    $index 1 -
] def
'shuffle-step private

'shuffle-vector [
    dup len 1 -
    [ 0 > ]
    [ shuffle-step ] while
    drop
] def
'shuffle-vector private

'shuffle [
    dup sequence? not
    [ "'random.shuffle' expected a sequence" error ] if
    dup type-of | family |
    >vector shuffle-vector
    [
        [ [ $family "vector" == ] [] ]
        [ [ $family "list" == ] [ >list ] ]
        [ [ true ] [ >string ] ]
    ] cond
] def
