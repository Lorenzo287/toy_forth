'inc [ 1 + ] def

'arithmetic [
    0 10000000 [ 1 + ] times
] def

'dispatch [
    0 10000000 [ inc ] times
] def

'fibonacci [
    32 [ 2 < ] [] [ pred dup pred ] [ + ] binrec
] def

'sequence [
    0 10 [
        [] 20000 [ 1 push-back ] times
        0 swap [ + ] fold +
    ] times
] def

'string-build [
    0 20 [
        "" 10000 [ "x" push-back ] times len +
    ] times
] def

'map-lookup [
    {} 50000 [ dup len dup 3 * assoc ] times | table |
    0
    20 [
        0 0 50000 [
            dup $table swap get rot + swap 1 +
        ] times drop +
    ] times
] def

cpu-time | started |

argv 0 at
dup "arithmetic" == [ drop arithmetic ] [
    dup "dispatch" == [ drop dispatch ] [
        dup "fibonacci" == [ drop fibonacci ] [
            dup "sequence" == [ drop sequence ] [
                dup "string" == [ drop string-build ] [
                    dup "map-lookup" == [ drop map-lookup ] [
                        "unknown cross-language benchmark: {}" format error
                    ] ifelse
                ] ifelse
            ] ifelse
        ] ifelse
    ] ifelse
] ifelse

| result |
cpu-time $started - | elapsed |
$result printf "\n" printf
$elapsed printf "\n" printf
